MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agaate
MYSQL_PASSWORD=
MYSQL_DATABASE=agaate

# Signed admin session cookie (min 32 characters)
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-32chars

# Seeded Super Admin (used by `npm run seed:admin`)
ADMIN_SEED_EMAIL=admin@agaate.in
ADMIN_SEED_PASSWORD=change-me-now

# Optional: email on new public contact submissions
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_FROM=Agaate <noreply@agaate.in>
RESEND_API_KEY=
